  "captions": [
    { "from": 0.40,  "to": 4.40,  "text": "Sitting on his throne, David said:" },
    { "from": 4.40,  "to": 7.10,  "text": "“How can I be in this beautiful palace," },
    { "from": 7.10,  "to": 8.30,  "text": "this beautiful kingdom?”" },
    { "from": 8.30,  "to": 10.90, "text": "The prophet came to meet him" },
    { "from": 10.90, "to": 12.40, "text": "and told him," },
    { "from": 12.40, "to": 13.51, "text": "“Because of this thing" },
    { "from": 13.51, "to": 14.80, "text": "you’ve thought about…" },
    { "from": 14.80, "to": 17.95, "text": "I will give him an everlasting kingdom.”" },
    { "from": 17.95, "to": 20.60, "text": "He planned for the temple." },
    { "from": 20.60, "to": 22.10, "text": "He planned for it." },
    { "from": 22.10, "to": 25.00, "text": "He planned for God’s house." },
    { "from": 25.00, "to": 27.35, "text": "Do you know God is very interested" },
    { "from": 27.35, "to": 30.00, "text": "in those that plan for His house?" }
  ]
